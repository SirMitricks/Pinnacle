# Скопируйте в .env и заполните. Файл .env в git не коммитится.
NODE_ENV=development
PORT=5000

DB_HOST=localhost
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=

# bcrypt-хеш токена администратора. Сгенерировать:
# node -e "import('bcryptjs').then(b=>console.log(b.default.hashSync(process.argv[1],12)))" "<длинный-случайный-токен>"
ADMIN_TOKEN_HASH=

# Список доверенных источников фронтенда через запятую
CORS_ORIGINS=http://localhost:5173

# В production HTTPS включается автоматически. За nginx — TRUST_PROXY=true
REQUIRE_HTTPS=false
TRUST_PROXY=false

AUDIT_LOG_PATH=logs/audit.log
